    <!-- Kafka Integration Settings
         Global Kafka consumer settings. Per-table settings (broker, topic, format) must be specified
         when creating Kafka tables. See example below.
    -->
    <kafka>
        <!-- How often to collect Kafka consumer statistics (milliseconds) -->
        <statistics_interval_ms>10000</statistics_interval_ms>
        
        <!-- Global consumer settings applied to all Kafka tables -->
        <consumer>
            <!-- Automatically commit offsets after processing messages -->
            <enable_auto_commit>true</enable_auto_commit>
            
            <kafka_group_name>clickhouse_consumer</kafka_group_name>
        </consumer>
    </kafka>

    <!-- Laptop-sized disk headroom (was 10 GB for production hosts). -->
    <min_free_disk_space>2147483648</min_free_disk_space> <!-- 2 GB -->
    <min_free_disk_space_for_merge>2147483648</min_free_disk_space_for_merge> <!-- 2 GB -->

    <!-- Small-box merge pool. Effective slots = pool * ratio must exceed ALL
         number_of_free_entries_in_pool_* defaults (mutation=20, optimize
         entire partition=25, …) — override those thresholds below. -->
    <background_pool_size>8</background_pool_size>
