# ClickHouse Cloud (primary datastore)
CLICKHOUSE_ENDPOINT=
CLICKHOUSE_HOST=
CLICKHOUSE_HTTPS_PORT=
CLICKHOUSE_NATIVE_SECURE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=

# Managed ClickStack / HyperDX (service Manual Tracers)
CLICKSTACK_TEAM_ID=
CLICKSTACK_SERVICE_ID=
CLICKHOUSE_CLOUD_ORG_ID=
# Required for source/dashboard API (Cloud console → API Keys, Org/Service Admin):
CLICKHOUSE_CLOUD_KEY_ID=
CLICKHOUSE_CLOUD_KEY_SECRET=

# RCA agent webhook target for ClickStack alerts
RCA_WEBHOOK_URL=

# Narrator LLM (Gemini via LangChain) — GEMINI_MODEL optional, defaults in code
GEMINI_API_KEY=
GEMINI_MODEL=

# Langfuse tracing — narrate() and the investigate.py ladder no-op tracing (not the
# investigation itself) when these are unset, so local dev/tests work without them
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
